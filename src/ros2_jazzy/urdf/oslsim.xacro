  <joint name="ankle" type="revolute">
    <parent link="shin"/>
    <child link="foot"/>
    <origin
      xyz="-0.00077967 -0.3134 -0.026811"
      rpy="0 1.5708 0" />
    <axis xyz="1 0 0"/>
     <limit effort="1.0" velocity="100" lower="-1.57" upper="1.57" /> 
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

  <link name="foot_heel">
    <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="0.00001" />
          <inertia ixx="1.6e-08" ixy="0.0" ixz="0.0" iyy="1.6e-08" iyz="0.0" izz="1.6e-08"/>
      </inertial>
      <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
              <sphere radius="0.020"/>
          </geometry>
      </collision>
  </link>

  <!-- <link name="osl_foot_loadcell_link">
    <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="0.00001" />
          <inertia ixx="1.6e-08" ixy="0.0" ixz="0.0" iyy="1.6e-08" iyz="0.0" izz="1.6e-08"/>
      </inertial>
      <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
              <sphere radius="0.020"/>
          </geometry>
      </collision>
  </link> -->

  <joint name="foot_heel_joint" type="fixed">
      <parent link="foot"/>
      <child link="foot_heel"/>
      <origin xyz="0.03 -0.065 0" rpy="0 0 0"/>
  </joint>

  <!-- <joint name="osl_foot_loadcell_link_joint" type="fixed">
      <parent link="osl_foot"/>
      <child link="osl_foot_loadcell_link"/>
      <origin xyz="-0.03 -0.065 0.03" rpy="0 0 0"/>
  </joint> -->
  <!-- ========================= -->
  <!-- IMU SENSOR (ROS 2 OK)    -->
  <!-- ========================= -->

  <gazebo reference="shin">
    <sensor name="shin_imu" type="imu">
      <topic>imu/osl_shank</topic>
      <imu>
        <frame>shin</frame>
      </imu>
      <always_on>true</always_on>
      <update_rate>50</update_rate>
    </sensor>
  </gazebo>

  <gazebo reference="foot">
    <sensor name="foot_imu" type="imu">
      <topic>imu/osl_foot</topic>
      <imu>
        <frame>foot</frame>
      </imu>
      <always_on>true</always_on>
      <update_rate>50</update_rate>
    </sensor>
  </gazebo>



</robot>
